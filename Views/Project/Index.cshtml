@model IEnumerable<CyberProjekt.Models.Project>

@{
    ViewData["Title"] = "Lista projektów";
    var canCreateProject = User.IsInRole("Administrator") || User.IsInRole("Pracownik");
}

<div class="container mt-5">
    <h2 class="text-white mb-4">Projekty</h2>

    @{
        ViewData["ActionName"] = "Index";
        ViewBag.Placeholder = "Szukaj projektów...";
    }
    <partial name="_SearchForm" />

    @if (Model != null && Model.Any())
    {
        <table class="table table-dark table-hover">
            <partial name="_ProjectTable" model="Model" />
        </table>
    }
    else
    {
        <div class="card p-4 mt-4 border-0 shadow-sm">
            <div class="d-flex flex-column align-items-center text-center">
                <h4 class="text-white mb-3">Brak projektów</h4>
                @if (canCreateProject)
                {
                    <p class="text-muted mb-4">Nie masz jeszcze żadnych projektów w systemie. Rozpocznij pracę, dodając swój pierwszy projekt.</p>
                    <a asp-controller="Project" asp-action="Create" class="btn btn-primary">
                        + Dodaj nowy projekt
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">Brak dostępnych projektów do wyświetlenia.</p>
                }
            </div>
        </div>
    }
</div>
<div class="toast-container position-fixed top-0 end-0 p-3">
    <div id="permissionToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-dark text-white">
            <strong class="me-auto">Task Manager</strong>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
        </div>
        <div class="toast-body bg-dark text-white">
            Nie masz uprawnień do edycji tego projektu.
        </div>
    </div>
</div>
@section Scripts {
    <script>
        function showPermissionToast() {
            var toastEl = document.getElementById('permissionToast');
            var toast = new bootstrap.Toast(toastEl);
            toast.show();
        }
    </script>
}