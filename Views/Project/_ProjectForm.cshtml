@model CyberProjekt.Models.Project

<input type="hidden" asp-for="ProjectId" />
<input type="hidden" asp-for="UserId" />

<div class="mb-3">
    <label asp-for="Name" class="form-label text-white">Nazwa projektu</label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label text-white">Opis</label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="StartDate" class="form-label text-white">Data rozpoczęcia</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="EndDate" class="form-label text-white">Data zakończenia</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>
</div>