@model CyberProjekt.Models.Project

@{
    ViewData["Title"] = "Usuń projekt";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4 bg-dark text-white border-danger">
                <h2 class="mb-4 text-danger">Czy na pewno chcesz usunąć ten projekt?</h2>
                <p>Tej operacji nie będzie można cofnąć.</p>

                <div class="bg-secondary bg-opacity-10 p-3 rounded mb-4">
                    <strong>Projekt:</strong> @Model.Name <br />
                    <small class="text-muted">Opis: @Model.Description</small>
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ProjectId" />
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-danger">Tak, usuń projekt</button>
                        <a asp-action="MyProjects" class="btn btn-outline-secondary">Anuluj</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>