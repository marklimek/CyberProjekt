@model IEnumerable<CyberProjekt.Models.User>
@using CyberProjekt.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<CyberProjekt.Models.User> UserManager

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        <strong>Błąd!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white">Użytkownicy</h2>
            <p class="text-muted">@Model.Count() członków zespołu w systemie</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
            + Dodaj użytkownika
        </button>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead style="background: #1e293b; color: #ffffff;">
                    <tr class="text-muted border-bottom border-secondary">
                        <th class="ps-4">UŻYTKOWNIK</th>
                        <th>E-MAIL</th>
                        <th>ROLA</th>
                        <th>PRZYPISANE ZADANIA</th>
                        <th>W REALIZACJI</th>
                        <th>ZAKOŃCZONE</th>
                        <th>AKCJE</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var tasks = user.AssignedTasks ?? new List<ProjectTask>();
                        var inProgress = tasks.Count(t => t.Status == CyberProjekt.Models.TaskStatus.InProgress);
                        var completed = tasks.Count(t => t.Status == CyberProjekt.Models.TaskStatus.Done);
                        var roles = await UserManager.GetRolesAsync(user);
                        var roleDisplay = roles.FirstOrDefault() ?? "Brak";
                        var roleBadgeClass = roleDisplay switch
                        {
                            "Administrator" => "bg-danger",
                            "Pracownik" => "bg-primary",
                            "Gość" => "bg-secondary",
                            _ => "bg-dark"
                        };

                        <tr class="align-middle border-bottom border-secondary">
                            <td class="d-flex align-items-center gap-3 ps-4 py-3">
                                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <span class="fw-bold">
                                        @(string.IsNullOrEmpty(user.FirstName) ? "?" : user.FirstName.Substring(0, 1))@(string.IsNullOrEmpty(user.LastName) ? "" : user.LastName.Substring(0, 1))
                                    </span>
                                </div>
                                <div>
                                    <div class="fw-bold">@user.FirstName @user.LastName</div>
                                    <div class="small text-muted">@user.UserName</div>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td>
                                <span class="badge @roleBadgeClass bg-opacity-25 text-light">
                                    @roleDisplay
                                </span>
                            </td>
                            <td class="fw-bold">@tasks.Count()</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold">@inProgress</span>
                                    <div class="progress" style="width: 60px; height: 4px;">
                                        <div class="progress-bar" style="width: @(tasks.Count() > 0 ? (inProgress * 100 / tasks.Count()) : 0)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="fw-bold text-success">@completed</span>
                                    <div class="progress" style="width: 60px; height: 4px;">
                                        <div class="progress-bar bg-success" style="width: @(tasks.Count() > 0 ? (completed * 100 / tasks.Count()) : 0)%"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="align-middle">
                                <div class="actions-container">
                                    <button type="button" class="btn btn-sm btn-edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editRoleModal"
                                            data-id="@user.Id"
                                            data-name="@user.FirstName @user.LastName"
                                            data-role="@roleDisplay"
                                            onclick="prepareEditModal(this)">
                                        Edytuj rolę
                                    </button>

                                    <form asp-action="DeleteUser" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-action btn-delete"
                                                onclick="return confirm('Czy na pewno chcesz usunąć tego użytkownika?');">
                                            <i class="bi bi-trash"></i>
                                            Usuń
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal dodawania użytkownika -->
<div class="modal fade" id="addUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card">
            <div class="modal-header border-0">
                <h5 class="modal-title">Dodaj nowego użytkownika</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Admin" asp-action="CreateUser" method="post">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Imię</label>
                            <input name="FirstName" class="form-control bg-dark text-white border-secondary" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Nazwisko</label>
                            <input name="LastName" class="form-control bg-dark text-white border-secondary" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Email</label>
                        <input name="Email" type="email" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Hasło początkowe</label>
                        <input name="Password" type="password" class="form-control bg-dark text-white border-secondary" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Rola</label>
                        <select name="Role" class="form-control bg-dark text-white border-secondary" required>
                            <option value="" selected disabled hidden>Wybierz rolę</option>
                            <option value="Administrator">Administrator</option>
                            <option value="Pracownik">Pracownik</option>
                            <option value="Gość">Gość</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary w-100">Utwórz konto</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal zmiany roli -->
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card">
            <form asp-action="ChangeRole" method="post">
                <input type="hidden" name="id" id="editUserId" />
                <div class="modal-header border-0">
                    <h5 class="modal-title">Edytuj uprawnienia</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">Użytkownik: <span id="userNameDisplay" class="text-light fw-bold"></span></p>
                    <label class="form-label text-muted">Nowa rola</label>
                    <select id="roleSelect" name="newRole" class="form-control bg-dark text-white border-secondary" required>
                    </select>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="btn btn-primary w-100">Zapisz zmiany</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function prepareEditModal(button) {
            const id = button.getAttribute('data-id');
            const name = button.getAttribute('data-name');
            const currentRole = button.getAttribute('data-role');

            document.getElementById('editUserId').value = id;
            document.getElementById('userNameDisplay').innerText = name;

            const select = document.getElementById('roleSelect');
            select.innerHTML = '<option value="" selected disabled hidden>Wybierz rolę</option>';

            const availableRoles = ['Administrator', 'Pracownik', 'Gość'];
            availableRoles.forEach(role => {
                if (role !== currentRole) {
                    const option = document.createElement('option');
                    option.value = role;
                    option.textContent = role;
                    select.appendChild(option);
                }
            });
        }
    </script>
}