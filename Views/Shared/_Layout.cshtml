@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using CyberProjekt.Data
@using Microsoft.EntityFrameworkCore
@inject IAuthorizationService AuthorizationService
@inject AppDbContext DbContext

@{
    var idleTimeoutMinutes = 15;
    if (User.Identity?.IsAuthenticated == true)
    {
        var policy = await DbContext.SecurityPolicies.AsNoTracking().FirstOrDefaultAsync();
        if (policy != null)
        {
            idleTimeoutMinutes = policy.SessionIdleTimeoutMinutes;
        }
    }
    var isGuest = User.IsInRole("Gość");
}

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CyberProjekt</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
            <div class="container-fluid d-flex justify-content-between align-items-center py-3 px-4">

                <div class="d-flex align-items-center">
                    <a class="navbar-brand fw-bold text-white me-4" asp-controller="Home" asp-action="RedirectHome">
                        Task Manager
                    </a>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-row gap-3">
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-folder2-open"></i> Projekt
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="Project" asp-action="Index">Lista projektów</a></li>
                                    @if (!isGuest)
                                    {
                                        <li><a class="dropdown-item" asp-controller="Project" asp-action="MyProjects">Moje projekty</a></li>
                                    }
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-list-task"></i> Zadanie
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-controller="ProjectTask" asp-action="Index">Lista zadań</a></li>
                                    @if (!isGuest)
                                    {
                                        <li><a class="dropdown-item" asp-controller="ProjectTask" asp-action="MyTasks">Moje zadania</a></li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    }
                </div>

                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle"></i>
                                @(User.FindFirst("FirstName")?.Value) @(User.FindFirst("LastName")?.Value)
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key"></i> Zmień hasło
                                    </a>
                                </li>
                            </ul>
                        </div>

                        @if ((await AuthorizationService.AuthorizeAsync(User, "RequireAdmin")).Succeeded)
                        {
                            <div class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-warning" href="#" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock"></i> Panel Administratora
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index" asp-route-tab="users">
                                            <i class="bi bi-people me-1"></i> Zarządzanie użytkownikami
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index" asp-route-tab="policy">
                                            <i class="bi bi-shield-check me-1"></i> Polityka bezpieczeństwa
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Index" asp-route-tab="stats">
                                            <i class="bi bi-bar-chart me-1"></i> Statystyki zadań
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }

                        <form asp-controller="Account" asp-action="Logout" method="post" class="mb-0">
                            <button type="submit" class="btn btn-outline-light btn-sm">Wyloguj</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login">Logowanie</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div>
            &copy; 2026 - CyberProjekt Maria Klimek
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/date-picker.js"></script>
    <script src="~/js/tasks-and-modals.js" asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function () {
                const idleTimeoutMs = @idleTimeoutMinutes * 60 * 1000;
                let logoutTimer;

                function resetIdleTimer() {
                    clearTimeout(logoutTimer);
                    logoutTimer = setTimeout(() => {
                        window.location.href = '/Account/ExpiredLogout';
                    }, idleTimeoutMs);
                }

                ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart', 'click'].forEach(evt => {
                    window.addEventListener(evt, resetIdleTimer, { passive: true });
                });

                resetIdleTimer();
            })();
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>