@{
    ViewData["Title"] = "Task Manager – System Zarządzania Zadaniami";
}

@if (Context.Request.Query["expired"] == "1")
{
    <div class="container mt-3">
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-clock-history me-2"></i>
            <strong>Sesja wygasła:</strong> zostałeś automatycznie wylogowany z powodu bezczynności. Zaloguj się ponownie, aby kontynuować.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
}

<section class="tm-hero text-center">
    <div class="container">
        <h1 class="text-white">System Zarządzania Zadaniami</h1>
        <p class="lead" style="color: var(--tm-muted)">Efektywna praca zespołowa w jednym miejscu.</p>
    </div>
</section>

<section id="features" class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Zarządzanie projektami</h5>
                    <p class="small">Twórz projekty, grupuj zadania i śledź postęp zespołu.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Tworzenie zadań</h5>
                    <p class="small">Definiuj zadania ze szczegółowym opisem i priorytetem.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Przypisywanie</h5>
                    <p class="small">Każde zadanie trafia do odpowiedniej osoby – zero niedomówień.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Statusy zadań</h5>
                    <p class="small">Śledź cykl życia: Nowe → W trakcie → Zakończone.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Terminy (Deadline)</h5>
                    <p class="small">Ustawiaj daty realizacji.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-4">
                    <h5 class="fw-bold">Komunikacja</h5>
                    <p class="small">Dyskutuj bezpośrednio przy zadaniu.</p>
                </div>
            </div>
        </div>
    </div>
</section>