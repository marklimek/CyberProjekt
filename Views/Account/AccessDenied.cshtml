@{
    ViewData["Title"] = "Brak dostępu (403)";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="card p-5 text-center" style="max-width: 500px; width: 100%;">
        <div class="mb-3">
            <i class="bi bi-shield-x text-danger" style="font-size: 3.5rem;"></i>
        </div>
        <h2 class="fw-bold text-danger mb-3">403 – Brak dostępu</h2>
        <p class="mb-4" style="color: var(--tm-muted);">
            Nie masz wymaganych uprawnień, aby wyświetlić tę stronę lub wykonać tę operację.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="RedirectHome" class="btn btn-primary">
                Wróć na stronę główną
            </a>
        </div>
    </div>
</div>