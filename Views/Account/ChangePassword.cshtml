@model CyberProjekt.Models.ViewModels.ChangePasswordViewModel
@using CyberProjekt.Models
@{
    ViewData["Title"] = "Zmiana hasła";
    var policy = ViewBag.Policy as SecurityPolicy ?? new SecurityPolicy();
}

<div class="container d-flex justify-content-center align-items-center py-5" style="min-height: 80vh;">
    <div class="card p-4" style="width: 100%; max-width: 500px;">
        <h2 class="text-center mb-3 fw-bold">
            <i class="bi bi-key me-2"></i>Zmiana hasła
        </h2>

        @if (Model.IsForcedChange)
        {
            <div class="alert alert-warning small mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                <strong>Wymagana zmiana hasła:</strong> musisz ustawić nowe hasło przed dalszym korzystaniem z systemu.
            </div>
        }

        <div class="p-3 rounded mb-3 small" style="background-color: var(--tm-bg); border: 1px solid #334155; color: var(--tm-muted);">
            <div class="fw-bold text-white mb-1">Wymagania polityki haseł:</div>
            <ul class="mb-0 ps-3">
                <li>Minimalna długość: <strong class="text-white">@policy.MinPasswordLength znaków</strong></li>
                @if (policy.IsEntropyPolicyEnabled)
                {
                    <li>Minimalna entropia: <strong class="text-white">@policy.MinEntropyBits bitów</strong></li>
                }
                <li>Nowe hasło musi różnić się od poprzednio używanych haseł.</li>
            </ul>
        </div>

        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

        <form asp-controller="Account" asp-action="ChangePassword" method="post">
            <input type="hidden" asp-for="IsForcedChange" />

            @if (!Model.IsForcedChange)
            {
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label" style="color: var(--tm-muted);">Aktualne hasło</label>
                    <input asp-for="CurrentPassword" type="password" class="form-control"
                           style="background-color: var(--tm-bg); border: 1px solid #334155; color: white;" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>
            }

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label" style="color: var(--tm-muted);">Nowe hasło</label>
                <input asp-for="NewPassword" id="newPasswordInput" type="password" class="form-control"
                       style="background-color: var(--tm-bg); border: 1px solid #334155; color: white;" />
                <span asp-validation-for="NewPassword" class="text-danger small"></span>

                <!-- Wskaźnik entropii i podpowiedź na żywo -->
                <div class="mt-2">
                    <div class="d-flex justify-content-between small mb-1">
                        <span style="color: var(--tm-muted);">Siła / entropia hasła:</span>
                        <span id="entropyValue" class="fw-bold text-white">0.0 / @policy.MinEntropyBits bitów</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div id="entropyBar" class="progress-bar bg-danger" role="progressbar" style="width: 0%;"></div>
                    </div>
                    <div id="entropyHint" class="small mt-1" style="color: var(--tm-muted);">
                        Zacznij wpisywać hasło, aby sprawdzić jego entropię.
                    </div>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label" style="color: var(--tm-muted);">Powtórz nowe hasło</label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control"
                       style="background-color: var(--tm-bg); border: 1px solid #334155; color: white;" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">Zapisz nowe hasło</button>
        </form>

        @if (!Model.IsForcedChange)
        {
            <div class="mt-3 text-center">
                <a asp-controller="Home" asp-action="Dashboard" class="small" style="color: var(--tm-muted); text-decoration: none;">
                    Anuluj i wróć do panelu
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const input = document.getElementById('newPasswordInput');
            const entropyValue = document.getElementById('entropyValue');
            const entropyBar = document.getElementById('entropyBar');
            const entropyHint = document.getElementById('entropyHint');

            const minLength = @policy.MinPasswordLength;
            const minEntropy = @policy.MinEntropyBits.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const entropyEnabled = @(policy.IsEntropyPolicyEnabled ? "true" : "false");

            function evaluatePassword(pwd) {
                if (!pwd) {
                    entropyValue.textContent = `0.0 / ${minEntropy} bitów`;
                    entropyBar.style.width = '0%';
                    entropyBar.className = 'progress-bar bg-danger';
                    entropyHint.textContent = 'Zacznij wpisywać hasło, aby sprawdzić jego entropię.';
                    entropyHint.style.color = 'var(--tm-muted)';
                    return;
                }

                let pool = 0;
                const hasLower = /[a-z]/.test(pwd);
                const hasUpper = /[A-Z]/.test(pwd);
                const hasDigit = /[0-9]/.test(pwd);
                const hasSpecial = /[^a-zA-Z0-9]/.test(pwd);

                if (hasLower) pool += 26;
                if (hasUpper) pool += 26;
                if (hasDigit) pool += 10;
                if (hasSpecial) pool += 32;

                const entropy = pool > 0 ? pwd.length * Math.log2(pool) : 0;
                const percent = Math.min(100, Math.round((entropy / minEntropy) * 100));

                entropyValue.textContent = `${entropy.toFixed(1)} / ${minEntropy} bitów`;
                entropyBar.style.width = `${percent}%`;

                const missing = [];
                if (pwd.length < minLength) missing.push(`co najmniej ${minLength - pwd.length} znaków więcej`);
                if (!hasUpper) missing.push('wielką literę');
                if (!hasDigit) missing.push('cyfrę');
                if (!hasSpecial) missing.push('znak specjalny (np. !, #, $)');

                const meetsLength = pwd.length >= minLength;
                const meetsEntropy = !entropyEnabled || entropy >= minEntropy;

                if (meetsLength && meetsEntropy) {
                    entropyBar.className = 'progress-bar bg-success';
                    entropyHint.textContent = 'Hasło spełnia wymagania bezpieczeństwa.';
                    entropyHint.style.color = '#4ade80';
                } else if (percent >= 65) {
                    entropyBar.className = 'progress-bar bg-warning';
                    entropyHint.textContent = missing.length > 0
                        ? `Prawie gotowe — dodaj: ${missing.join(', ')}.`
                        : `Wydłuż hasło, aby przekroczyć ${minEntropy} bitów entropii.`;
                    entropyHint.style.color = '#fbbf24';
                } else {
                    entropyBar.className = 'progress-bar bg-danger';
                    entropyHint.textContent = missing.length > 0
                        ? `Zbyt słabe hasło — dodaj: ${missing.join(', ')}.`
                        : `Wydłuż hasło, aby zwiększyć entropię.`;
                    entropyHint.style.color = '#f87171';
                }
            }

            input.addEventListener('input', () => evaluatePassword(input.value));
        })();
    </script>
}